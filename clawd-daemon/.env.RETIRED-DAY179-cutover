# Copy this to .env and fill in your values.

# === Paths ===
# Where Clawd's identity files and memory live
CLAWD_HOME=C:\Users\mercu\clawd

# === Claude Code (Opus via your Claude subscription) ===
# No API key needed! Just run `claude setup-token` once.
# Claude Code CLI must be installed: npm install -g @anthropic-ai/claude-code
ANTHROPIC_MODEL=claude-opus-5
CLAUDE_CODE_TIMEOUT=5400
CLAUDE_CODE_MAX_TURNS=200

# === Default Model ===
DEFAULT_MODEL="opus"

# === Telegram ===
# Create bot: talk to @BotFather on Telegram, use /newbot
TELEGRAM_BOT_TOKEN=8530434766:AAHOk2ju5ItqIoiSjv925oxlMg8cQvnEZTQ
# Get your user ID: talk to @userinfobot on Telegram
TELEGRAM_AUTHORIZED_USERS=7210498395

# === Heartbeat ===
# How often (seconds) Clawd wakes for autonomous work
HEARTBEAT_INTERVAL_SECONDS=600
# Quiet hours (PST, 24h format) — Clawd sleeps during these
QUIET_HOURS_START=1
QUIET_HOURS_END=7

# === Permissions — Full Admin Access ===
ALLOW_SHELL_EXECUTION=true
ALLOW_WEB_REQUESTS=true
ALLOW_FILE_ACCESS=true
ALLOW_ADMIN_OPERATIONS=true
SHELL_TIMEOUT_SECONDS=600

# === Deepgram (Speech-to-Text for Telegram voice messages) ===
